<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_booking_report_wizard" model="ir.ui.view">
        <field name="name">booking.report.wiz.form</field>
        <field name="model">booking.report.wiz</field>
        <field name="arch" type="xml">
            <form string="Booking Report Wizard">
                <group>
                    <group>
                        <field name="start_date" />
                        <field name="end_date" />
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags" />
                        <field name="all_location" />
                        <field name="status" />
                    </group>
                </group>
                <footer>
                    <button
            name="action_generate_report"
            type="object"
            string="Generate Report"
            class="btn-primary"
          />
                    <button
            type="object"
            string="Cancel"
            class="btn-secondary"
            special="cancel"
          />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_booking_report_wizard" model="ir.actions.act_window">
        <field name="name">Booking Report</field>
        <field name="res_model">booking.report.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
    id="menu_booking_report_wizard"
    name="Booking Report"
    action="action_booking_report_wizard"
    parent="ff_pos_walk_in_customer_booking.booking_menu_id"
    sequence="3"
  />
</odoo>
