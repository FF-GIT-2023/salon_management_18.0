<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="booking_report_template">
        <t t-call="web.html_container">
            <div class="page text-center">
                <style>
                    .table {
                        border-collapse: collapse;
                        width: 100%;
                        text-align: center;
                        margin-top: 10px;
                        font-family: Arial, sans-serif;
                    }
                    .table th, .table td {
                        border: 1px solid #d1d5db;
                        padding: 10px;
                        font-size: 13px;
                    }
                    .table th {
                        background-color: #f5f5f5;
                        font-weight: bold;
                    }
                    .table tbody tr:nth-child(even) {
                        background-color: #f9fafb;
                    }
                    .table tbody tr:nth-child(odd) {
                        background-color: white;
                    }
                    .table tbody tr:hover {
                        background-color: #e5e7eb;
                    }
                </style>

                <div style="font-weight: bold; color: black; text-align: center;">
                    <h2 class="text-center">Booking Report</h2>
                    <div>
                        Period: <b><span t-raw="start_date" /> - <span
                t-raw="end_date"
              /></b>
                    </div>
                </div>

                <t t-if="company_wise_data">
                    <t t-foreach="company_wise_data.items()" t-as="company">
                        <h3
              class="text-left"
              style="margin-top: 30px; font-weight: bold;"
            >
                            <t t-esc="company[1]['company_name']" />
                        </h3>

                        <t
              t-set="show_confirmed_columns"
              t-value="any(doc.get('state') == 'confirm' for doc in company[1]['records'])"
            />

                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Customer Name</th>
                                    <th>Contact Number</th>
                                    <th>Booking Created Date</th>
                                    <t t-if="show_confirmed_columns">
                                        <th>Booking Confirmed Person</th>
                                        <th>Booking Confirmed Date</th>
                                    </t>
                                    <th>Selected Services</th>
                                    <th>Service Duration</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="company[1]['records']" t-as="doc">
                                    <tr>
                                        <td t-esc="doc.get('customer_id')[1]" />
                                        <td t-esc="doc.get('phone_no')" />
                                        <td>
                                            <t
                        t-esc="doc.get('create_date') and doc.get('create_date')[:10].replace('-', '/').split('/')[2] + '/' + doc.get('create_date')[:10].replace('-', '/').split('/')[1] + '/' + doc.get('create_date')[:10].replace('-', '/').split('/')[0]"
                      />
                                        </td>
                                        <t t-if="show_confirmed_columns">
                                            <td>
                                                <t
                          t-if="doc.get('state') == 'confirm' and doc.get('active_user')"
                        >
                                                    <t t-esc="doc.get('active_user')" />
                                                </t>
                                            </td>
                                            <td>
                                                <t
                          t-if="doc.get('state') == 'confirm' and doc.get('start')"
                        >
                                                    <t
                            t-esc="doc.get('start') and doc.get('start')[:10].replace('-', '/').split('/')[2] + '/' + doc.get('start')[:10].replace('-', '/').split('/')[1] + '/' + doc.get('start')[:10].replace('-', '/').split('/')[0]"
                          />
                                                </t>
                                            </td>
                                        </t>
                                        <td t-esc="doc.get('name').split(':')[0]" />
                                        <td>
                                            <t t-if="doc.get('duration') >= 3600">
                                                <t
                          t-esc="int(doc.get('duration') // 3600)"
                        /> hrs
                                            </t>
                                            <t t-elif="doc.get('duration') >= 60">
                                                <t
                          t-esc="int(doc.get('duration') // 60)"
                        /> mins
                                            </t>
                                            <t t-else="">
                                                <t
                          t-esc="int(doc.get('duration'))"
                        /> sec
                                            </t>
                                        </td>
                                        <td t-esc="doc.get('state')" />
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </t>
            </div>
        </t>
    </template>
</odoo>
