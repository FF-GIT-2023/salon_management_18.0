<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="work_schedule_report_template">
        <t t-call="web.html_container">
            <div class="page">
                <table
          class="table table-bordered table-striped" style="width: 100%;,background-color:'#96D4D4;';,border:'solid';"
        >
                    <thead>
                        <th class="text-center"><strong>Employee Name</strong></th>
                        <th class="text-center"><strong>Work Status</strong></th>
                        <th class="text-center"><strong>Start From</strong></th>
                        <th class="text-center"><strong>End To</strong></th>
                        <th class="text-center"><strong>No. Of Hours</strong></th>
                    </thead>
                    <tbody>
                    <tr t-foreach="docs" t-as="o" style="border:'solid'">
                        <td class="text-center"><span t-field="o.user_id.name" /></td>
                        <td class="text-center"><span t-field="o.state" /></td>
                        <td class="text-center"><span t-field="o.start_date" /> </td>
                        <td class="text-center"><span t-field="o.end_date" /></td>
                        <td class="text-center"><span t-esc="'%.2f'% o.time" /></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <record id="work_schedule_report" model="ir.actions.report">
        <field name="name">Work Schedule Report</field>
        <field name="model">worker.schedule</field>
        <field name="report_type">qweb-pdf</field>
        <field
      name="report_name"
    >ff_salon_worker_schedule.work_schedule_report_template</field>
        <field
      name="report_file"
    >ff_salon_worker_schedule.work_schedule_report_template</field>
        <field name="binding_model_id" ref="model_worker_schedule" />
        <field name="binding_type">report</field>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
