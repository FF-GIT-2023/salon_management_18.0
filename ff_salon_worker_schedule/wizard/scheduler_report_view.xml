<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_scheduler_report_wiz_form" model="ir.ui.view">
        <field name="name">Scheduler Report Wizard</field>
        <field name="model">scheduler.report.wiz</field>
        <field name="arch" type="xml">
            <form string="Work Scheduler Report">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from" required="1" />
                        </group>
                        <group>
                            <field name="date_to" required="1" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
            string="Cancel"
            class="btn-secondary"
            special="cancel"
            data-hotkey="z"
          />
                    <button
            string="Generate Report"
            type="object"
            name="generate_report"
            class="btn btn-primary"
          />
                                        <button
            string="Generate Excel Report"
            type="object"
            name="print_scheduler_xls"
            class="btn btn-primary"
          />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_scheduler_report_wiz_view" model="ir.actions.act_window">
        <field name="name">Scheduler Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">scheduler.report.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
        <menuitem
    id="worker_schedule_report_wiz_menu"
    name="Schedule Report"
    parent="worker_schedule_sub"
    action="action_scheduler_report_wiz_view"
    sequence="2"
  />
</odoo>
