            <!-- Appointment Start -->
            <div class="container-fluid appointment py-5" style="background: var(--bs-primary);">
                <div class="container py-5">
                    <div class="row g-5 align-items-center">
                        <div class="col-lg-6">
                            <div class="appointment-form p-5">
                                <h1 class="display-4 mb-4 text-white">Sign Up</h1>
                                <form id="signupForm">
                                    <div class="row gy-3 gx-4">
                                        <div class="col-lg-6">
                                            <input type="text"
                                                   class="form-control py-3 border-white text-black"
                                                   placeholder="Name" name="name" required="required"/>
                                        </div>
                                        <div class="col-lg-6">
                                            <input type="email"
                                                   class="form-control py-3 border-white text-black"
                                                   placeholder="Email" name="email" required="required"/>
                                        </div>
                                        <div class="col-lg-6">
                                            <input type="password" class="form-control py-3 border-white text-black"
                                                   placeholder="Password" id="password" name="password"
                                                   required="required"/>
                                        </div>
                                        <div class="col-lg-6">
                                            <input type="password" class="form-control py-3 border-white text-black"
                                                   placeholder="Confirm Password" id="confirm_password"
                                                   name="confirm_password" required="required"/>
                                        </div>
                                        <div class="col-lg-6">
                                            <select class="form-select py-3 border-white"
                                                    aria-label="Default select example" name="location_id"
                                                    required="required">
                                                <t t-foreach="location" t-as="location">
                                                    <option t-att-value="location.id" t-esc="location.name"
                                                            placeholder="Preferred location" name="location_id"
                                                            style="color:black !important" required="required"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-lg-6">
                                            <input type="text" class="form-control bg-white border-0 py-3 px-4"
                                                   placeholder="Your Phone" id="phone" pattern="[0-9]{10}" name="phone"
                                                   required="required"/>
                                            <small id="password_error" class="text-danger d-none">
                                                Passwords do not match
                                            </small>
                                        </div>

                                        <div class="col-lg-12">
                                            <button type="submit" formaction="/confirm/signup"
                                                    class="btn btn-primary btn-primary-outline-0 w-100 py-3 px-5">SUBMIT
                                                NOW
                                            </button>
                                        </div>
                                        <div class="modal fade" id="incorrectpasswords" tabindex="-1"
                                             aria-labelledby="userPopupLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 rounded-4 shadow-lg">

                                                    <!-- Header -->
                                                    <div class="modal-header text-white"
                                                         style="background: var(--bs-primary);">
                                                        <h5 class="modal-title fw-bold" id="bookingPopupLabel">
                                                            Signup Status
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white"
                                                                data-bs-dismiss="modal"
                                                                aria-label="Close"/>
                                                    </div>

                                                    <!-- Body -->
                                                    <div class="modal-body text-center p-4">
                                                        <i class="fa fa-calendar-times fa-3x text-danger mb-3"/>
                                                        <h4 class="mb-3 text-dark">Password Error</h4>
                                                        <p class="text-muted mb-0">
                                                            The format of Password is incorrect, format should contain 8
                                                            characters with atleast 1 Uppercase and lowercase character,
                                                            atleast 1 number and special character !
                                                        </p>
                                                    </div>

                                                    <!-- Footer -->
                                                    <div class="modal-footer border-0 justify-content-center pb-4">
                                                        <button type="button"
                                                                class="btn btn-primary px-4 py-2 rounded-pill"
                                                                data-bs-dismiss="modal">
                                                            OK
                                                        </button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                        <t t-if="incorrectformat">
                                            <script>
                                                document.addEventListener("DOMContentLoaded", function () {
                                                var popup = new bootstrap.Modal(document.getElementById('incorrectpasswords'));
                                                popup.show();
                                                });
                                            </script>
                                        </t>

                                        <div class="modal fade" id="userPopup" tabindex="-1"
                                             aria-labelledby="userPopupLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 rounded-4 shadow-lg">

                                                    <!-- Header -->
                                                    <div class="modal-header text-white"
                                                         style="background: var(--bs-primary);">
                                                        <h5 class="modal-title fw-bold" id="bookingPopupLabel">
                                                            Signup Status
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white"
                                                                data-bs-dismiss="modal"
                                                                aria-label="Close"/>
                                                    </div>

                                                    <!-- Body -->
