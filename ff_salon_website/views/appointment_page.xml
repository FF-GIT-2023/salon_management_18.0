                                <form>
                                    <div class="row gy-3 gx-4">
                                        <div class="col-lg-6">
                                            <input type="text"
                                                   class="form-control py-3 border-white text-black"
                                                   placeholder="First Name" name="name" required="required"/>
                                        </div>
                                        <div class="col-lg-6">
                                            <input type="email"
                                                   class="form-control py-3 border-white text-black"
                                                   placeholder="Email" name="email" required="required"/>
                                        </div>
                                        <div class="col-lg-6">
                                            <select class="form-select py-3 border-white "
                                                    aria-label="Default select example" name="service">
                                                <t t-foreach="services" t-as="service" required="required">
                                                    <option t-att-value="service.id" t-esc="service.name"
                                                            placeholder="Service" name="service_id"
                                                            style="color:black !important" required="required"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-lg-6">
                                            <select class="form-select py-3 border-white"
                                                    aria-label="Default select example" name="location_id" required="required">
                                                <t t-foreach="locations" t-as="location">
                                                    <option t-att-value="location.id" t-esc="location.name"
                                                            placeholder="location" name="location_id"
                                                            style="color:black !important" required="required"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-lg-6">
                                            <input type="datetime-local"
                                                   class="form-control py-3 border-white"
                                                   name="date_time"
                                                   id="date_time"
                                                   required="required"/>
                                            <small id="error-msg" style="color:red; display:none;">
                                                Past date and time are not allowed.
                                            </small>
                                        </div>
                                        <div class="col-lg-6">
                                            <input type="text" class="form-control bg-white border-0 py-3 px-4"
                                                   placeholder="Your Phone" id="phone" pattern="[0-9]{10}" name="phone"
                                                   required="required"/>
                                        </div>

                                        <script>
                                            document.addEventListener("DOMContentLoaded", function () {

                                            let input = document.getElementById("date_time");
                                            let errorMsg = document.getElementById("error-msg");

                                            // Function to format current datetime for input min
                                            function setMinDateTime() {
                                            let now = new Date();
                                            now.setSeconds(0, 0);

                                            let year = now.getFullYear();
                                            let month = String(now.getMonth() + 1).padStart(2, '0');
                                            let day = String(now.getDate()).padStart(2, '0');
                                            let hours = String(now.getHours()).padStart(2, '0');
                                            let minutes = String(now.getMinutes()).padStart(2, '0');

                                            let currentDateTime = `${year}-${month}-${day}T${hours}:${minutes}`;
                                            input.min = currentDateTime;
                                            }

                                            setMinDateTime();

                                            input.addEventListener("input", function () {
                                            let selectedDate = new Date(input.value);
                                            let currentDate = new Date();

                                            if (selectedDate &lt; currentDate) {
                                            errorMsg.style.display = "block";
                                            input.value = "";
                                            } else {
                                            errorMsg.style.display = "none";
                                            }
                                            });

                                            });
                                        </script>
