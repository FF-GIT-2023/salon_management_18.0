<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_salon_bookings" model="ir.module.category">
        <field name="name">Salon Bookings</field>
        <field name="description">Helps you handle your salon bookings</field>
        <field name="sequence">5</field>
    </record>
    <record id="group_salon_booking_user" model="res.groups">
        <field name="name">Booking User</field>
        <field
      name="category_id"
      ref="ff_pos_walk_in_customer_booking.module_category_salon_bookings"
    />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_salon_booking_manager" model="res.groups">
        <field name="name">Booking Manager</field>
        <field
      name="category_id"
      ref="ff_pos_walk_in_customer_booking.module_category_salon_bookings"
    />
        <field name="implied_ids" eval="[(4, ref('group_salon_booking_user'))]" />
        <field
      name="users"
      eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
    />
    </record>

</odoo>
