<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sms_config_form" model="ir.ui.view">
        <field name="name">sms.config.form</field>
        <field name="model">sms.configuration</field>
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="username" />
                            <field name="api_key" />
                            <p>
                                <b>Recharge Link: </b> <a
                  href="https://dashboard.clicksend.com/account/subaccounts"
                >Click Here</a>
                            </p>
                        </group>
                        <group />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sms_config" model="ir.actions.act_window">
        <field name="name">SMS Configuration</field>
        <field name="res_model">sms.configuration</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sms_config_form" />
        <field name="target">current</field>
    </record>
    <menuitem
    id="sms_conf_menu_id"
    name="SMS Configuration"
    parent="calendar.mail_menu_calendar"
    sequence="50"
    action="action_sms_config"
  />
</odoo>
