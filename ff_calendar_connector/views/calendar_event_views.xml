<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_calendar_event_form_inherit" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button
            name="action_confirm"
            string="Confirm"
            type="object"
            class="oe_highlight"
            invisible="state in ['cancel','confirm']"
            groups="base.group_user"
          />

                    <button
            name="action_cancel"
            string="Cancel"
            type="object"
            invisible="state=='cancel'"
            groups="base.group_user"
          />

                    <button
            name="action_set_to_pending"
            string="Set to Pending"
            type="object"
            invisible="state in 'pending','confirm'"
            groups="base.group_user"
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="pending,confirm"
          />
                </header>
            </xpath>
            <xpath
        expr="//form/sheet/group/group[1]/field[@name='user_id']"
        position="after"
      >
                <field name="customer_id" string="Customer" />
                <field name="mail" />
                <field name="phone_no" widget="phone" />
                <field name="note" />
            </xpath>
            <xpath
        expr="//form/sheet/group/group[1]/field[@name='categ_ids']"
        position="after"
      >
                <field name="active_user" invisible="state in 'pending','cancel'" />
            </xpath>
            <xpath
        expr="//form/sheet/div[contains(@class, 'oe_title mb-3')]"
        position="replace"
      >
                <h1>
                    <field name="name" placeholder="e.g. Lashes" />
                </h1>
            </xpath>
            <xpath
        expr="//form/sheet/notebook/page[@name='page_invitations']"
        position="attributes"
      >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
        expr="//form/sheet/group/group[1]/field[@name='location']"
        position="after"
      >
                <xpath
          expr="//form/sheet/group/group[1]/field[@name='user_id']"
          position="move"
        />
            </xpath>
            <xpath
        expr="//form/sheet/group/group[1]/field[@name='location']"
        position="attributes"
      >
                <attribute name="string">Location</attribute>
            </xpath>

            <xpath
        expr="//form/sheet/group/group[1]/field[@name='recurrency']"
        position="attributes"
      >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath
        expr="//form/sheet/group/group[1]/div[6]/field[@name='videocall_location']"
        position="attributes"
      >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath
        expr="//form/sheet/group/group[1]/div[6]/button[@name='set_discuss_videocall_location']"
        position="attributes"
      >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath
        expr="//form/sheet/group/group[1]/field[@name='categ_ids']"
        position="attributes"
      >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath
        expr="//form/sheet/group/group[1]/div[hasclass('o_row')]/field[@name='show_as']"
        position="attributes"
      >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath
        expr="//form/sheet/group/group[1]/div[hasclass('o_row')]/field[@name='privacy']"
        position="attributes"
      >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath
        expr="//form/sheet/group/group[1]/field[@name='description']"
        position="attributes"
      >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_calendar_event_tree_inherit" model="ir.ui.view">
        <field name="name">calendar.event.tree.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree" />
        <field name="arch" type="xml">

            <xpath expr="//list/field[@name='name']" position="attributes">
                <attribute name="string">Service</attribute>
            </xpath>

            <xpath expr="//list/field[@name='start']" position="attributes">
                <attribute name="string">SR Opening Time</attribute>
            </xpath>

            <xpath expr="//list/field[@name='stop']" position="attributes">
                <attribute name="string">SR Completion Time</attribute>
            </xpath>

            <xpath expr="//list/field[@name='user_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//list/field[@name='partner_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//list/field[@name='duration']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//list/field[@name='location']" position="attributes">
                <attribute name="string">Location</attribute>
            </xpath>

            <xpath expr="//list/field[@name='name']" position="after">
                <field name="customer_id" string="Customer" optional="show" />
                <field name="mail" optional="show" />
                <field name="phone_no" optional="show" />
                <field name="note" optional="show" />
                <field name="create_date" optional="show" />
                <field name="active_user" invisible="state in ['pending','cancel']" />
                <field
          name="removed_by"
          invisible="state in ['confirm', 'pending', 'cancel']"
        />
                <field
          name="removed_on"
          invisible="state in ['confirm', 'pending', 'cancel']"
        />
            </xpath>

            <xpath expr="//list/field[@name='duration']" position="after">
                <field
          name="state"
          decoration-success="state == 'confirm'"
          decoration-danger="state == 'cancel'"
          decoration-warning="state == 'pending'"
          decoration-info="state == 'removed'"
          optional="show"
          widget="badge"
        />
            </xpath>
        </field>
    </record>

    <record id="view_calendar_event_kanban" model="ir.ui.view">
        <field name="name">calendar.event.kanban</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false">
                <field name="state" />
                <field name="customer_id" />
                <field name="name" />
                <field name="user_id" />
                <field name="active_user" />
                <field name="create_date" />
                <field name="start" />
                <field name="stop" />
                <field name="location" />
                <progressbar
          field="state"
          colors='{"confirm": "success", "pending": "warning", "cancel": "danger", "removed": "info"}'
          help="This bar allows to filter the records based on state."
        />
                <templates>
                    <t t-name="kanban-box">
                        <div
              t-attf-class="#{kanban_color(record.state.raw_value)} oe_kanban_global_click o_has_icon oe_kanban_content oe_kanban_card"
            >
                            <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_card">
                                    <div t-if="record.customer_id.raw_value">
                                        <strong>Customer:</strong>
                                        <field name="customer_id" />
                                    </div>
                                    <div t-if="record.name.raw_value">
                                        <strong>Service:</strong>
                                        <field name="name" />
                                    </div>
                                    <div t-if="record.user_id.raw_value">
                                        <strong>Staff:</strong>
                                        <field name="user_id" />
                                    </div>
                                    <div
                      t-if="record.active_user.raw_value"
                      invisible="state in 'pending','cancel'"
                    >
                                        <strong>Confirmed By:</strong>
                                        <field name="active_user" />
                                    </div>
                                    <div t-if="record.create_date.raw_value">
                                        <strong>Booking Date and Time:</strong>
                                        <field name="create_date" />
                                    </div>
                                    <div t-if="record.start.raw_value">
                                        <strong>SR Opening Time:</strong>
                                        <field name="start" />
                                    </div>
                                    <div t-if="record.stop.raw_value">
                                        <strong>SR Completion Time:</strong>
                                        <field name="stop" />
                                    </div>
                                    <div t-if="record.location.raw_value">
                                        <strong>Location:</strong>
                                        <field name="location" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_task_search_form_inherit" model="ir.ui.view">
        <field name="name">calendar.event.search</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search" />
        <field name="arch" type="xml">
            <xpath expr="//search/group" position="inside">
                <filter
          string="Staff"
          name="staff_filter"
          context="{'group_by':'user_id'}"
        />
            </xpath>
        </field>
    </record>

    <record id="calendar.action_calendar_event" model="ir.actions.act_window">
        <field name="name">Casa Online Bookings</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field
      name="domain"
    >[('company_id', '=', context.get('allowed_company_ids')[0])]
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Bookings found. Let's create one!
            </p>
        </field>
    </record>
</odoo>
